{
  "expo": {
    "name": "7xCircle Wallet",
    "slug": "7xcircle-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "openwallet",
    "plugins": [
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow 7xCircle Wallet to access the camera for scanning WalletConnect QR codes"
        }
      ]
    ],
    "android": {
      "package": "com.openwallet.app",
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#101114"
      }
    }
  }
}
