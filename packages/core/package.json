{
  "name": "@7xcircle/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.6.0",
    "@7xcircle/shared": "workspace:*",
    "@scure/bip32": "^2.4.0",
    "bip39": "^3.1.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0"
  }
}
